rules_version = '2';

// PaperTrail's database rules. Paste them into Firebase: Firestore Database → Rules → Publish.
// Each signed-in person can read and write only their own data, under users/{their user id}.
// Anything else in the database is closed to everyone.

service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Business details and numbering
    match /users/{userId} {
      allow read, delete: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && request.resource.data.keys().hasOnly(['version', 'business', 'counters'])
        && request.resource.data.business is map
        && request.resource.data.counters is map;

      // One quote or invoice each
      match /documents/{docId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && request.resource.data.id == docId
          && request.resource.data.type in ['quote', 'invoice']
          && request.resource.data.number is string
          && request.resource.data.number.size() <= 30
          && request.resource.data.items is list
          && request.resource.data.items.size() <= 200
          && request.resource.data.payments is list
          && request.resource.data.payments.size() <= 200;
      }

      // One expense each
      match /expenses/{expenseId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && request.resource.data.keys().hasOnly(['id', 'date', 'supplier', 'description', 'category', 'amount', 'vatClaimable', 'hasReceipt', 'createdAt', 'updatedAt'])
          && request.resource.data.id == expenseId
          && request.resource.data.date is string
          && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && request.resource.data.supplier is string
          && request.resource.data.supplier.size() <= 200
          && request.resource.data.description is string
          && request.resource.data.description.size() <= 500
          && request.resource.data.category in ['materials', 'fuel', 'tools', 'rent', 'phone', 'software', 'bank', 'marketing', 'other']
          && request.resource.data.amount is int
          && request.resource.data.amount >= 0
          && request.resource.data.vatClaimable is bool
          && request.resource.data.hasReceipt is bool;
      }

      // The photo of a receipt: one small JPEG, stored as text
      match /receipts/{expenseId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && request.resource.data.keys().hasOnly(['image'])
          && request.resource.data.image is string
          && request.resource.data.image.size() <= 750000
          && request.resource.data.image.matches('^data:image/jpeg;base64,.*');
      }
    }

    // Everything else: closed
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
